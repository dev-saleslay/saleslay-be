# Server
PORT=3001
NODE_ENV=development

# Frontend URL (used for OAuth redirects and CORS)
FRONTEND_URL=http://localhost:3000

# Auth — must match the frontend's AUTH_SECRET / NEXTAUTH_SECRET
AUTH_SECRET=your-secret-here
NEXTAUTH_SECRET=your-secret-here

# Database
DATABASE_URL=mongodb+srv://...

# HubSpot OAuth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/crm/hubspot/callback

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_INBOUND_WEBHOOK_TOKEN=
TWILIO_INBOUND_SKIP_SIGNATURE=0
SALESLAY_PUBLIC_ORIGIN=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_INBOUND_WEBHOOK_SECRET=

# Resend
RESEND_API_KEY=

# OpenAI (optional — for template alignment)
OPENAI_API_KEY=
OPENAI_ALIGN_MODEL=gpt-4o-mini

# Cron
CRON_SECRET=

# Encryption (for stored API keys / tokens)
EMAIL_API_KEY_ENCRYPTION_KEY=
TWILIO_TOKEN_ENCRYPTION_KEY=
